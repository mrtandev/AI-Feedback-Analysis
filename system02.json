    {
      "parameters": {
        "jsCode": "// 1. ดึงค่า JSON String จากผลลัพธ์ของ Node \"Message a model\"\nconst jsonString = $json.content.parts[0].text;\n\n// 2. ทำความสะอาด JSON String: (ใช้โค้ดที่สมบูรณ์จากคำตอบก่อนหน้า)\nlet cleanedString = jsonString\n    .trim()\n    .replace(/\\\\\"/g, '\"')\n    .replace(/\\n/g, '');\n\n// 3. ตรวจสอบและ Parse JSON:\ntry {\n    const startIndex = cleanedString.indexOf('{');\n    const endIndex = cleanedString.lastIndexOf('}');\n    \n    if (startIndex !== -1 && endIndex !== -1) {\n        const jsonObjectString = cleanedString.substring(startIndex, endIndex + 1);\n        \n        // คืนค่าเป็น JavaScript Object (ไม่ใช่ String)\n        return JSON.parse(jsonObjectString);\n    } else {\n        console.error(\"Error: Could not find valid JSON object start/end markers.\");\n        return { error: \"JSON object not found in AI response\" };\n    }\n} catch (e) {\n    console.error(\"Error parsing JSON:\", e);\n    return { error: \"Failed to parse JSON\", originalText: jsonString };\n}"
      },
